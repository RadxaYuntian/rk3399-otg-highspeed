#!/usr/bin/env bash
# Force RK3399 usbdrd3_0 SuperSpeed PHY into USB2-only via GRF.
# Required when tcphy0 is disabled: the typec PHY driver is what normally
# programs these bits.

set -euo pipefail
shopt -s nullglob

python3 - <<EOF
import os, mmap, struct
GRF = 0xff770000
def hiword_write(m, off, bit, enable):
    # Rockchip hiword write: bit N + mask bit (N+16)
    m[off:off+4] = struct.pack("<I", (1 << (bit + 16)) | ((1 if enable else 0) << bit))

fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
m = mmap.mmap(fd, 0x10000, offset=GRF)
# usb3tousb2_en = 1
hiword_write(m, 0xe580, 3, 1)
# host_u3_port_disable = 1
hiword_write(m, 0x2434, 0, 1)
# host_u3_port[15:12] = 0
m[0x2434:0x2434+4] = struct.pack("<I", (0xF << (12 + 16)) | (0 << 12))

phy = struct.unpack_from("<I", m, 0xe580)[0]
otg = struct.unpack_from("<I", m, 0x2434)[0]
m.close()
os.close(fd)
print(f"GRF USB3PHY0_CON0={phy:#010x} USB3OTG0_CON1={otg:#010x}")
EOF

# Re-trigger Type-C HS root hub so already-plugged devices re-enumerate
if [[ -e /sys/bus/platform/drivers/xhci-hcd/xhci-hcd.1.auto ]]; then
  echo xhci-hcd.1.auto > /sys/bus/platform/drivers/xhci-hcd/unbind 2>/dev/null || true
  sleep 0.2
  echo xhci-hcd.1.auto > /sys/bus/platform/drivers/xhci-hcd/bind 2>/dev/null || true
elif [[ -e /sys/devices/platform/usb@fe800000/fe800000.usb/xhci-hcd.1.auto ]]; then
  # Fallback: cycle authorization on usb1
  if [[ -e /sys/bus/usb/devices/usb1/authorized ]]; then
    echo 0 > /sys/bus/usb/devices/usb1/authorized || true
    echo 1 > /sys/bus/usb/devices/usb1/authorized || true
  fi
fi
